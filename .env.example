# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.
# Agents: every variable below is documented with who reads it and when it is safe to use.

# ── App (required for `pnpm dev` / `pnpm build` / `pnpm test:e2e`) ────────────────
# Supabase project URL + publishable key. Read by src/lib/env.ts, which throws at import
# if either is missing. Use the *publishable* key; the ANON_KEY name is not used.
# ⚠ This points at the PRODUCTION project (ref isbmudrwmokzcgrklial). Anything the app or
#   `pnpm test:e2e` writes lands in real data. Prefer `pnpm test:e2e:local` (SQLite).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── E2E sign-in against Supabase (`pnpm test:e2e`) ──────────────────────────────
# Read by tests/e2e/helpers.ts credentialsFor(): E2E_<ACCOUNT>_EMAIL / _PASSWORD.
# A spec for an account whose pair is missing is skipped. Not needed for
# `pnpm test:e2e:local`, which signs in as <account>@local.test with any password.
# These are real production accounts, so the same warning applies.
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=
E2E_FOODIVA_EMAIL=
E2E_FOODIVA_PASSWORD=
E2E_CHEF_EMAIL=
E2E_CHEF_PASSWORD=
E2E_SALADAENG_EMAIL=
E2E_SALADAENG_PASSWORD=
E2E_MINBURI_EMAIL=
E2E_MINBURI_PASSWORD=

# ── Set by scripts, not by hand (listed so agents know what they are) ─────────────
# NEXT_PUBLIC_LOCAL_DB=1   local SQLite mode instead of Supabase; set by `pnpm test:e2e:local`
# LOCAL_DB_FILE            SQLite file for local mode (default .local/app.db)
# E2E_PORT=3101            extra parallel local e2e lane: own port, DB and .next dir
# E2E_RUN                  run folder name under artifacts/e2e-runs/
# NEXT_DIST_DIR            alternative .next dir (per local e2e lane)
# VISUAL=1 / SHOT_DIR=...  include tests/e2e/_visual-baseline.spec.ts (screenshots)
