# LF everywhere, whatever core.autocrlf says, so prettier (endOfLine: lf) passes on Windows too.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.xlsx binary
*.docx binary
*.zip binary
